if (data.error) {
  showError('Deriv API error: <b>' + data.error.message + '</b><br>Try a different instrument or timeframe.');
  ws.close(); return;
}

if (data.msg_type === 'candles') {
  ws.close();
  const raw = data.candles || [];
  if (!raw.length) {
    showError('No candle data returned. This instrument may not support this timeframe. Try M5 or M15.');
    return;
  }

  // Filter out currently-forming candle
  const nowSec = Math.floor(Date.now() / 1000);
  const closed = raw.filter(c => (nowSec - c.epoch) >= gran);

  // Take the last N closed candles
  const slice = closed.slice(-need);

  if (slice.length < (mode === 'scalp' ? 3 : 5)) {
    showError('Not enough closed candles. Try M5 or M15 timeframe and try again.');
    return;
  }

  const cc = slice.map(c => ({
    o: parseFloat(c.open),
    h: parseFloat(c.high),
    l: parseFloat(c.low),
    c: parseFloat(c.close),
    epoch: c.epoch
  }));

  hideLoading();
  showPreview(cc);
  renderResults(engine(cc), cc);
}
```

};

ws.onerror = function() {
