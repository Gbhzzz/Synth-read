<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Synth Analyzer</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Bebas+Neue&display=swap');

:root {
–bg: #04080d;
–s1: #080f17;
–s2: #0c1820;
–border: #132030;
–border2: #1e3048;
–bull: #05f0a0;
–bear: #f03060;
–warn: #f0c030;
–accent: #0088ff;
–text: #8fafc8;
–bright: #c8e0f0;
–muted: #2a4860;
–step: #a060ff;
–balanced: #ff8c00;
}

- { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘IBM Plex Mono’, monospace;
font-size: 12px;
min-height: 100vh;
}

body::after {
content: ‘’;
position: fixed;
inset: 0;
background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.08) 2px, rgba(0,0,0,0.08) 4px);
pointer-events: none;
z-index: 999;
}

.wrap { max-width: 480px; margin: 0 auto; padding: 16px 12px 80px; }

.hdr {
display: flex;
align-items: flex-start;
justify-content: space-between;
margin-bottom: 16px;
padding-bottom: 12px;
border-bottom: 1px solid var(–border);
}

.logo { font-family: ‘Bebas Neue’, sans-serif; font-size: 26px; letter-spacing: 3px; color: var(–bright); line-height: 1; }
.logo em { color: var(–accent); font-style: normal; }
.version { font-size: 9px; letter-spacing: 2px; color: var(–muted); text-transform: uppercase; margin-top: 3px; }

.mode-toggle { display: flex; background: var(–s2); border: 1px solid var(–border); border-radius: 6px; padding: 3px; gap: 3px; }
.mode-btn {
font-family: ‘IBM Plex Mono’, monospace; font-size: 10px; font-weight: 700;
letter-spacing: 1px; padding: 7px 12px; border-radius: 4px; border: 1px solid transparent;
cursor: pointer; transition: all 0.15s; background: transparent; color: var(–muted);
text-align: center; line-height: 1.4; -webkit-user-select: none; user-select: none;
}
.mode-btn.active-scalp { background: rgba(0,136,255,0.2); color: var(–accent); border-color: rgba(0,136,255,0.4); }
.mode-btn.active-balanced { background: rgba(255,140,0,0.15); color: var(–balanced); border-color: rgba(255,140,0,0.4); }

.mode-banner { border-radius: 5px; padding: 8px 12px; margin-bottom: 12px; font-size: 10px; line-height: 1.5; border: 1px solid; }
.mode-banner.scalp-banner { background: rgba(0,136,255,0.06); border-color: rgba(0,136,255,0.2); color: #6ab0ff; }
.mode-banner.balanced-banner { background: rgba(255,140,0,0.06); border-color: rgba(255,140,0,0.2); color: #ffaa44; }

.pills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 12px; }
.pill {
background: var(–s1); border: 1px solid var(–border); color: var(–muted);
font-family: ‘IBM Plex Mono’, monospace; font-size: 10px; font-weight: 600;
letter-spacing: 1px; padding: 8px 4px; border-radius: 4px; cursor: pointer;
text-align: center; transition: all 0.12s; -webkit-user-select: none; user-select: none;
}
.pill:active { transform: scale(0.96); }
.pill.active { background: rgba(0,136,255,0.12); border-color: var(–accent); color: var(–accent); }
.pill.step-active { background: rgba(160,96,255,0.12); border-color: var(–step); color: var(–step); }

.tf-row { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
.tf-btn { background: var(–s1); border: 1px solid var(–border); color: var(–muted); font-family: ‘IBM Plex Mono’, monospace; font-size: 10px; padding: 5px 10px; border-radius: 3px; cursor: pointer; transition: all 0.12s; }
.tf-btn.active { border-color: var(–border2); color: var(–bright); background: var(–s2); }

.fetch-btn {
width: 100%;
background: linear-gradient(135deg, rgba(0,136,255,0.15), rgba(0,136,255,0.05));
border: 1px solid rgba(0,136,255,0.4);
color: var(–accent);
font-family: ‘Bebas Neue’, sans-serif;
font-size: 22px;
letter-spacing: 3px;
padding: 16px;
border-radius: 6px;
cursor: pointer;
transition: all 0.15s;
margin-bottom: 12px;
display: flex;
align-items: center;
justify-content: center;
gap: 10px;
}
.fetch-btn.balanced-fetch { background: linear-gradient(135deg,rgba(255,140,0,0.12),rgba(255,140,0,0.04)); border-color: rgba(255,140,0,0.4); color: var(–balanced); }
.fetch-btn:active { transform: scale(0.98); }
.fetch-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

.loading-wrap {
display: none; flex-direction: column; align-items: center; gap: 10px;
padding: 20px; background: var(–s1); border: 1px solid var(–border);
border-radius: 6px; margin-bottom: 12px;
}
.loading-wrap.show { display: flex; }
.loader { width: 28px; height: 28px; border: 2px solid var(–border); border-top-color: var(–accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 10px; letter-spacing: 2px; color: var(–muted); text-transform: uppercase; }

.error-box { display: none; background: rgba(240,48,96,0.08); border: 1px solid rgba(240,48,96,0.3); border-radius: 5px; padding: 12px; font-size: 11px; color: var(–bear); margin-bottom: 10px; line-height: 1.6; }

.candle-preview { display: none; background: var(–s1); border: 1px solid var(–border); border-radius: 6px; padding: 12px 14px; margin-bottom: 10px; }
.preview-title { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(–muted); margin-bottom: 8px; display: flex; justify-content: space-between; }
.preview-title span { color: var(–bull); }
.preview-rows { display: flex; flex-direction: column; gap: 3px; }
.preview-row { display: grid; grid-template-columns: 20px 1fr 1fr 1fr 1fr; gap: 4px; font-size: 10px; }
.pr-num { color: var(–muted); text-align: center; }
.pr-bull { color: var(–bull); text-align: center; }
.pr-bear { color: var(–bear); text-align: center; }
.pr-h { color: #6ab0ff; text-align: center; }
.pr-l { color: #ff8080; text-align: center; }

#results { display: none; }

.result-mode-badge { display: inline-block; font-size: 9px; letter-spacing: 1.5px; padding: 3px 10px; border-radius: 10px; margin-bottom: 10px; text-transform: uppercase; }
.badge-scalp { background: rgba(0,136,255,0.15); color: var(–accent); border: 1px solid rgba(0,136,255,0.3); }
.badge-balanced { background: rgba(255,140,0,0.15); color: var(–balanced); border: 1px solid rgba(255,140,0,0.3); }

.bias-block { border-radius: 6px; padding: 18px 14px; margin-bottom: 10px; border: 1px solid; position: relative; overflow: hidden; }
.bias-block::before { content: ‘’; position: absolute; top: -40px; right: -40px; width: 120px; height: 120px; border-radius: 50%; opacity: 0.06; }
.bias-block.bull { background: rgba(5,240,160,0.05); border-color: rgba(5,240,160,0.3); }
.bias-block.bull::before { background: var(–bull); }
.bias-block.bear { background: rgba(240,48,96,0.05); border-color: rgba(240,48,96,0.3); }
.bias-block.bear::before { background: var(–bear); }
.bias-block.neutral { background: rgba(240,192,48,0.05); border-color: rgba(240,192,48,0.3); }

.bias-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.bias-label { font-family: ‘Bebas Neue’, sans-serif; font-size: 52px; line-height: 1; letter-spacing: 2px; }
.bull .bias-label { color: var(–bull); text-shadow: 0 0 30px rgba(5,240,160,0.4); }
.bear .bias-label { color: var(–bear); text-shadow: 0 0 30px rgba(240,48,96,0.4); }
.neutral .bias-label { color: var(–warn); }
.bias-right { text-align: right; }
.conf-pct { font-family: ‘Bebas Neue’, sans-serif; font-size: 32px; line-height: 1; }
.bull .conf-pct { color: var(–bull); }
.bear .conf-pct { color: var(–bear); }
.neutral .conf-pct { color: var(–warn); }
.conf-track { width: 80px; height: 3px; background: var(–border); border-radius: 2px; margin: 6px 0 0 auto; overflow: hidden; }
.conf-fill { height: 100%; border-radius: 2px; transition: width 0.5s ease; }
.bull .conf-fill { background: var(–bull); }
.bear .conf-fill { background: var(–bear); }
.neutral .conf-fill { background: var(–warn); }
.bias-sub { font-size: 9px; letter-spacing: 1px; color: var(–muted); margin-top: 2px; }
.bias-note { font-size: 11px; color: var(–text); line-height: 1.6; padding-top: 12px; border-top: 1px solid var(–border); }

.rr-warning { background: rgba(240,48,96,0.08); border: 1px solid rgba(240,48,96,0.3); border-radius: 5px; padding: 10px 12px; font-size: 11px; color: var(–bear); margin-bottom: 10px; line-height: 1.5; }
.rr-good { background: rgba(5,240,160,0.06); border: 1px solid rgba(5,240,160,0.25); border-radius: 5px; padding: 10px 12px; font-size: 11px; color: var(–bull); margin-bottom: 10px; line-height: 1.5; }

.chart-wrap { margin-bottom: 10px; background: var(–s1); border: 1px solid var(–border); border-radius: 6px; padding: 10px 10px 6px; }
canvas { display: block; width: 100%; }

.stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 10px; }
.stat-box { background: var(–s1); border: 1px solid var(–border); border-radius: 5px; padding: 10px 8px; text-align: center; }
.stat-lbl { font-size: 8px; letter-spacing: 1.5px; text-transform: uppercase; color: var(–muted); margin-bottom: 5px; }
.stat-val { font-size: 14px; font-weight: 700; color: var(–bright); }

.card { background: var(–s1); border: 1px solid var(–border); border-radius: 6px; padding: 14px; margin-bottom: 10px; }
.card-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(–muted); margin-bottom: 10px; }

.signal-list { display: flex; flex-direction: column; }
.sig-item { display: flex; gap: 10px; align-items: flex-start; padding: 9px 0; border-bottom: 1px solid var(–border); }
.sig-item:last-child { border-bottom: none; }
.sig-icon { font-size: 13px; flex-shrink: 0; margin-top: 1px; }
.sig-text { font-size: 11px; color: var(–text); line-height: 1.5; }
.sig-text b { color: var(–bright); }

.levels-list { display: flex; flex-direction: column; }
.lev-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px solid var(–border); }
.lev-row:last-child { border-bottom: none; }
.lev-name { font-size: 9px; letter-spacing: 1px; color: var(–muted); text-transform: uppercase; }
.lev-val { font-size: 13px; font-weight: 600; }
.lev-tag { font-size: 8px; padding: 2px 7px; border-radius: 10px; }
.tag-supply { background: rgba(240,48,96,0.15); color: var(–bear); }
.tag-demand { background: rgba(5,240,160,0.15); color: var(–bull); }
.tag-mid { background: rgba(240,192,48,0.12); color: var(–warn); }
.tag-cur { background: rgba(200,224,240,0.08); color: var(–bright); }

.scalp-box { background: var(–s1); border: 1px solid var(–border); border-radius: 6px; padding: 14px; margin-bottom: 10px; }
.scalp-title { font-size: 9px; letter-spacing: 2px; color: var(–muted); text-transform: uppercase; margin-bottom: 12px; }
.scalp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.scalp-item { background: var(–s2); border: 1px solid var(–border); border-radius: 4px; padding: 9px 10px; }
.scalp-item-lbl { font-size: 8px; letter-spacing: 1px; text-transform: uppercase; color: var(–muted); margin-bottom: 4px; }
.scalp-item-val { font-size: 15px; font-weight: 700; }

.exhaust-wrap { margin-bottom: 10px; }
.exhaust-bar-track { height: 8px; background: var(–s2); border-radius: 4px; overflow: hidden; margin-top: 8px; border: 1px solid var(–border); }
.exhaust-fill { height: 100%; border-radius: 4px; transition: width 0.5s ease; }
.exhaust-label-row { display: flex; justify-content: space-between; margin-top: 4px; font-size: 9px; color: var(–muted); }

.step-note { background: rgba(160,96,255,0.08); border: 1px solid rgba(160,96,255,0.25); border-radius: 5px; padding: 10px 12px; font-size: 10px; color: #c0a0ff; margin-bottom: 10px; line-height: 1.6; }

.trend-strength { background: var(–s1); border: 1px solid var(–border); border-radius: 6px; padding: 14px; margin-bottom: 10px; }
.ts-bars { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
.ts-row { display: flex; align-items: center; gap: 8px; }
.ts-label { font-size: 9px; color: var(–muted); width: 80px; flex-shrink: 0; }
.ts-track { flex: 1; height: 5px; background: var(–border); border-radius: 3px; overflow: hidden; }
.ts-fill { height: 100%; border-radius: 3px; transition: width 0.5s ease; }
.ts-val { font-size: 10px; font-weight: 700; width: 36px; text-align: right; }

@keyframes fadeUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
.animate-in { animation: fadeUp 0.25s ease forwards; }
</style>

</head>
