function showPreview(cc) {
const dp = Math.max(…cc.map(c => { const s = c.c.toString().split(’.’)[1]; return s ? s.length : 0; }));
const fmt = v => v.toFixed(dp);
document.getElementById(‘candlePreview’).style.display = ‘block’;
let html = `<div class="preview-row" style="margin-bottom:4px">
<div></div>
<div style="color:var(--muted);font-size:9px;text-align:center">O</div>
<div style="color:var(--muted);font-size:9px;text-align:center">H</div>
<div style="color:var(--muted);font-size:9px;text-align:center">L</div>
<div style="color:var(--muted);font-size:9px;text-align:center">C</div>

  </div>`;
  cc.forEach((c, i) => {
    const bull = c.c >= c.o, cl = bull ? 'pr-bull' : 'pr-bear';
    html += `<div class="preview-row">
      <div class="pr-num">${i+1}</div>
      <div class="${cl}">${fmt(c.o)}</div>
      <div class="pr-h">${fmt(c.h)}</div>
      <div class="pr-l">${fmt(c.l)}</div>
      <div class="${cl}">${fmt(c.c)}</div>
    </div>`;
  });
  document.getElementById('previewRows').innerHTML = html;
}

// ─── ANALYSIS ENGINE ──────────────────────────────────
function engine(cc) {
const n = cc.length, last = cc[n-1], prev = n >= 2 ? cc[n-2] : null;
const allH = cc.map(c => c.h), allL = cc.map(c => c.l);
const trs = cc.map((c,i) => i===0 ? c.h-c.l : Math.max(c.h-c.l, Math.abs(c.h-cc[i-1].c), Math.abs(c.l-cc[i-1].c)));
const atr = trs.reduce((a,b) => a+b, 0) / n;
const recentATR = trs.slice(-3).reduce((a,b) => a+b, 0) / Math.min(3, n);
const dp = Math.max(…cc.map(c => { const s = c.c.toString().split(’.’)[1]; return s ? s.length : 0; }));
const fmt = v => v.toFixed(dp);

// Structure
const swH = [], swL = [];
for (let i = 1; i < n-1; i++) {
if (cc[i].h > cc[i-1].h && cc[i].h > cc[i+1].h) swH.push(cc[i].h);
if (cc[i].l < cc[i-1].l && cc[i].l < cc[i+1].l) swL.push(cc[i].l);
}
let structure = ‘ranging’;
if (swH.length >= 2 && swL.length >= 2) {
const hh = swH[swH.length-1] > swH[swH.length-2], hl = swL[swL.length-1] > swL[swL.length-2];
const lh = swH[swH.length-1] < swH[swH.length-2], ll = swL[swL.length-1] < swL[swL.length-2];
if (hh && hl) structure = ‘bullish’;
else if (lh && ll) structure = ‘bearish’;
} else {
structure = last.c > cc[0].c * 1.0005 ? ‘bullish’ : last.c < cc[0].c * 0.9995 ? ‘bearish’ : ‘ranging’;
}

const bullC = cc.filter(c => c.c > c.o).length, bearC = cc.filter(c => c.c < c.o).length;
const swingHigh = Math.max(…allH), swingLow = Math.min(…allL), fullRange = swingHigh - swingLow || 1;

let bos = null;
if (n >= 3) {
const ph = Math.max(…allH.slice(0, n-1)), pl = Math.min(…allL.slice(0, n-1));
if (last.c > ph) bos = ‘bull’; else if (last.c < pl) bos = ‘bear’;
}

const body = Math.abs(last.c - last.o), rng = last.h - last.l || 0.0001;
const topWick = last.h - Math.max(last.c, last.o), botWick = Math.min(last.c, last.o) - last.l;
const bodyPct = Math.round((body / rng) * 100), isBullLast = last.c > last.o;
const bullEngulf = prev && last.c > last.o && prev.c < prev.o && last.c >= prev.o && last.o <= prev.c;
const bearEngulf = prev && last.c < last.o && prev.c > prev.o && last.c <= prev.o && last.o >= prev.c;
const bullPin = !isStep && botWick > body * 1.8 && botWick > topWick;
const bearPin = !isStep && topWick > body * 1.8 && topWick > botWick;
const momBull = isBullLast && bodyPct >= 65, momBear = !isBullLast && bodyPct >= 65;
const doji = bodyPct < 15 && !isStep;

let consec = 1; const consecDir = isBullLast ? ‘bull’ : ‘bear’;
for (let i = n-2; i >= 0; i–) { if ((cc[i].c > cc[i].o) === isBullLast) consec++; else break; }

const rangeRatio = (last.h - last.l) / (atr || 1);
const isExpanding = rangeRatio > 1.3, isContracting = rangeRatio < 0.6;

let stepRun = 0, stepDir = ‘’;
if (isStep) {
stepDir = last.c > last.o ? ‘up’ : ‘down’;
for (let i = n-1; i >= 0; i–) { if ((cc[i].c > cc[i].o) === (last.c > last.o)) stepRun++; else break; }
}

const deltas = cc.map(c => { const r = c.h - c.l || 1; return ((c.c - c.l) / r - 0.5) * 2; });
const recentDelta = deltas.slice(-3).reduce((a,b) => a+b, 0);
const pricePos = (last.c - swingLow) / fullRange;

let exhaustPct = 0;
exhaustPct += Math.min(40, consec * (mode === ‘balanced’ ? 6 : 10));
exhaustPct += Math.min(20, bodyPct * 0.2);
if (pricePos > 0.8 && consecDir === ‘bull’) exhaustPct += 25;
if (pricePos < 0.2 && consecDir === ‘bear’) exhaustPct += 25;
if (isStep && stepRun >= 4) exhaustPct += 20;
exhaustPct = Math.min(98, exhaustPct);

// Dynamic R:R from real levels
const roomAbove = swingHigh - last.c;
let slDist, tp1Dist, tp2Dist;
if (mode === ‘scalp’) {
slDist    = isStep ? recentATR * 0.6 : recentATR * 0.75;
tp1Dist   = Math.min(roomAbove * 0.6,  recentATR * 1.5);
tp2Dist   = Math.min(roomAbove * 0.88, recentATR * 2.5);
} else {
slDist    = recentATR * 0.8;
tp1Dist   = Math.min(roomAbove * 0.55, recentATR * 2.0);
tp2Dist   = Math.min(roomAbove * 0.85, recentATR * 3.5);
}
slDist  = Math.max(slDist,  atr * 0.3);
tp1Dist = Math.max(tp1Dist, atr * 0.8);
tp2Dist = Math.max(tp2Dist, atr * 1.5);

const rrRatio = tp1Dist / slDist, rrGood = rrRatio >= 1.5, rrStr = rrRatio.toFixed(1);
const entry = last.c;
const scalp = { entry,
slL: entry - slDist,   tp1L: entry + tp1Dist, tp2L: entry + tp2Dist,
slS: entry + slDist,   tp1S: entry - tp1Dist, tp2S: entry - tp2Dist };

// Scoring
let bull = 0, bear = 0; const sigs = [];
if (structure === ‘bullish’) bull += mode === ‘balanced’ ? 3 : 2;
if (structure === ‘bearish’) bear += mode === ‘balanced’ ? 3 : 2;
if (bos === ‘bull’) { bull += 3; sigs.push({t:‘bull’, txt:’<b>Bullish BOS</b> — closed above prior range high. Trend continuation.’}); }
if (bos === ‘bear’) { bear += 3; sigs.push({t:‘bear’, txt:’<b>Bearish BOS</b> — closed below prior range low. Sellers in control.’}); }
if (bullEngulf) { bull += 2.5; sigs.push({t:‘bull’, txt:’<b>Bullish engulfing</b> — buyers absorbed prior bearish candle.’}); }
if (bearEngulf) { bear += 2.5; sigs.push({t:‘bear’, txt:’<b>Bearish engulfing</b> — sellers absorbed prior bullish candle.’}); }
if (bullPin)    { bull += 2;   sigs.push({t:‘bull’, txt:’<b>Bullish pin bar</b> — strong rejection of lower prices.’}); }
if (bearPin)    { bear += 2;   sigs.push({t:‘bear’, txt:’<b>Bearish pin bar</b> — sellers rejecting highs hard.’}); }
if (momBull && !bullEngulf) { bull += 1.5; sigs.push({t:‘bull’, txt:`<b>Momentum candle</b> — ${bodyPct}% body. Buyers pushing hard.`}); }
if (momBear && !bearEngulf) { bear += 1.5; sigs.push({t:‘bear’, txt:`<b>Momentum candle</b> — ${bodyPct}% body. Sellers driving down.`}); }
if (doji) sigs.push({t:‘warn’, txt:’<b>Doji / indecision</b> — wait for next candle to confirm direction.’});

if (consec >= 3 && exhaustPct > 60) {
sigs.push({t:‘warn’, txt:`<b>${consec} consecutive ${consecDir==='bull'?'▲':'▼'} candles</b> — exhaustion building. Pullback risk.`});
if (consecDir === ‘bull’) bear += 1; else bull += 1;
} else if (consec >= 2) {
sigs.push({t: consecDir, txt:`<b>${consec} candles same direction</b> — momentum building ${consecDir==='bull'?'upward':'downward'}.`});
if (consecDir === ‘bull’) bull += 1; else bear += 1;
}

if (isExpanding) sigs.push({t: isBullLast?‘bull’:‘bear’, txt:`<b>Range expanding</b> — last candle ${(rangeRatio*100-100).toFixed(0)}% wider than average.`});
if (isContracting) sigs.push({t:‘warn’, txt:’<b>Range contracting</b> — compression. Breakout incoming.’});
if (recentDelta >  0.5) { bull += 0.5; sigs.push({t:‘bull’, txt:’<b>Order flow positive</b> — closes near highs. Buyers absorbing.’}); }
if (recentDelta < -0.5) { bear += 0.5; sigs.push({t:‘bear’, txt:’<b>Order flow negative</b> — closes near lows. Sellers absorbing.’}); }

if (mode === ‘balanced’) {
const mid = swingLow + fullRange * 0.5;
if (last.c > mid && structure === ‘bullish’) { bull += 1; sigs.push({t:‘bull’, txt:’<b>Price above midpoint</b> — bulls holding upper half.’}); }
if (last.c < mid && structure === ‘bearish’) { bear += 1; sigs.push({t:‘bear’, txt:’<b>Price below midpoint</b> — bears holding lower half.’}); }
if (structure === ‘bullish’ && bullC/n >= 0.6) { bull += 1; sigs.push({t:‘bull’, txt:`<b>Trend consistency</b> — ${bullC}/${n} candles bullish.`}); }
if (structure === ‘bearish’ && bearC/n >= 0.6) { bear += 1; sigs.push({t:‘bear’, txt:`<b>Trend consistency</b> — ${bearC}/${n} candles bearish.`}); }
}

// Always show price position
const pp = (pricePos * 100).toFixed(0);
if      (pricePos > 0.80) { bear += 1; sigs.push({t:‘bear’, txt:`Price at <b>${pp}% of range</b> — near supply. Avoid new longs. Good for shorts.`}); }
else if (pricePos > 0.60) sigs.push({t:‘warn’, txt:`Price at <b>${pp}% of range</b> — upper half. Longs: TP1 only. Better zone for shorts.`});
else if (pricePos >= 0.40) sigs.push({t:‘warn’, txt:`Price at <b>${pp}% of range</b> — mid range. Either direction ok. Target TP1 primarily.`});
else if (pricePos >= 0.20) { bull += 0.5; sigs.push({t:‘bull’, txt:`Price at <b>${pp}% of range</b> — lower half. Good room above. TP1 and TP2 reachable.`}); }
else { bull += 1; sigs.push({t:‘bull’, txt:`Price at <b>${pp}% of range</b> — near demand. Ideal for longs. Avoid new shorts.`}); }

if (!rrGood) sigs.push({t:‘warn’, txt:`<b>R:R is ${rrStr}:1</b> — below 1.5. Wait for a better entry position.`});

if (isStep) {
sigs.unshift({t: stepDir===‘up’?‘bull’:‘bear’, txt:`<b>Step Index:</b> ${stepRun} consecutive ${stepDir} steps. ${stepRun>=4?'Exhausting — possible reversal.':'Trend in motion.'}`});
if (stepRun >= 4) { if (stepDir===‘up’) bear += 1.5; else bull += 1.5; }
}

let bias, conf; const total = bull + bear;
if      (bull > bear) { bias=‘LONG’;  conf = total>0 ? Math.min(94, Math.round((bull/total)*100)) : 50; }
else if (bear > bull) { bias=‘SHORT’; conf = total>0 ? Math.min(94, Math.round((bear/total)*100)) : 50; }
else                  { bias=‘WAIT’;  conf = 50; }

const mn = mode === ‘balanced’ ? ’Use H1 for direction, M15/M5 for entry. ’ : ‘’;
const notes = {
LONG:  structure===‘bullish’
? `${mn}Structure bullish. Price at ${pp}% of range. ${bos==='bull'?'BOS confirmed. ':''}${rrGood?`R:R ${rrStr}:1 — acceptable.`:'R:R weak — wait for pullback to demand for better entry.'}`
: `${mn}Mixed structure but signals favour long. Wait for bullish candle close before entering. Price must hold above ${fmt(last.h)}.`,
SHORT: structure===‘bearish’
? `${mn}Structure bearish. Price at ${pp}% of range. ${bos==='bear'?'BOS confirmed. ':''}${rrGood?`R:R ${rrStr}:1 — acceptable.`:'R:R weak — wait for bounce to supply for better entry.'}`
: `${mn}Mixed structure but signals favour short. Wait for bearish confirmation candle. Price must break ${fmt(last.l)} cleanly.`,
WAIT:  `${mn}No dominant bias. Structure ${structure}. Price at ${pp}% of range. Sit out — wait for BOS or strong momentum candle.`
};

return { bias, conf, structure, bos, sigs, atr, bodyPct, consec, consecDir,
exhaustPct, pricePos, dp, fmt, stepRun, stepDir, rrRatio, rrGood, rrStr,
bullC, bearC, n, levels: {hi:swingHigh, lo:swingLow, mid:swingLow+fullRange*0.5, cur:last.c},
scalp, note: notes[bias] };
}

// ─── RENDER ───────────────────────────────────────────
function renderResults(r, cc) {
document.getElementById(‘results’).style.display = ‘block’;
const cls = r.bias===‘LONG’ ? ‘bull’ : r.bias===‘SHORT’ ? ‘bear’ : ‘neutral’;
const col = cls===‘bull’ ? ‘var(–bull)’ : cls===‘bear’ ? ‘var(–bear)’ : ‘var(–warn)’;

const badge = document.getElementById(‘resultModeBadge’);
badge.className = `result-mode-badge ${mode==='scalp'?'badge-scalp':'badge-balanced'} animate-in`;
badge.textContent = mode===‘scalp’ ? `⚡ Scalp · ${r.n} Candles · ${tf}` : `⚖️ Balanced · ${r.n} Candles · ${tf}`;

document.getElementById(‘rrBox’).innerHTML = r.rrGood
? `<div class="rr-good animate-in">✓ R:R is <b>${r.rrStr}:1</b> — setup math acceptable. ${r.rrRatio>=2?'Room for TP1 and TP2.':'Target TP1 primarily.'}</div>`
: `<div class="rr-warning animate-in">⚠ R:R is only <b>${r.rrStr}:1</b> — below 1.5. Too close to ${r.bias==='LONG'?'supply':'demand'}. Wait for better entry.</div>`;

const bb = document.getElementById(‘biasBlock’);
bb.className = `bias-block ${cls} animate-in`;
document.getElementById(‘biasLbl’).textContent = r.bias;
document.getElementById(‘biasSub’).textContent = `${instFull} · ${tf} · LIVE`;
document.getElementById(‘confPct’).textContent = r.conf + ‘%’;
document.getElementById(‘confFill’).style.width = r.conf + ‘%’;
document.getElementById(‘biasNote’).textContent = r.note;
document.getElementById(‘stepNote’).style.display = isStep ? ‘block’ : ‘none’;

const ts = document.getElementById(‘trendStrength’);
if (mode === ‘balanced’) {
ts.style.display = ‘block’;
const items = [
{ l:‘Structure’,   v: r.structure===‘bullish’?80:r.structure===‘bearish’?20:50 },
{ l:‘Candle Flow’, v: Math.max(r.bullC,r.bearC)/r.n*100|0 },
{ l:‘BOS Signal’,  v: r.bos ? 85 : 45 },
{ l:‘Energy Left’, v: 100 - r.exhaustPct | 0 },
];
document.getElementById(‘tsBars’).innerHTML = items.map(x => {
const c = x.v>60?‘var(–bull)’:x.v<40?‘var(–bear)’:‘var(–warn)’;
return `<div class="ts-row"><div class="ts-label">${x.l}</div><div class="ts-track"><div class="ts-fill" style="width:${x.v}%;background:${c}"></div></div><div class="ts-val" style="color:${c}">${x.v}%</div></div>`;
}).join(’’);
} else ts.style.display = ‘none’;

const ep = r.exhaustPct, exC = ep<40?‘var(–bull)’:ep<70?‘var(–warn)’:‘var(–bear)’;
document.getElementById(‘exhaustText’).innerHTML =
`Momentum: <b style="color:${exC}">${ep<40?'Fresh — trend has legs':ep<70?'Building — watch for slowdown':'High — reversal / pullback risk'}</b>`;
const ef = document.getElementById(‘exhaustFill’);
ef.style.width = ep + ‘%’; ef.style.background = `linear-gradient(90deg,var(--bull),${exC})`;

document.getElementById(‘statStruct’).textContent = r.structure.toUpperCase();
document.getElementById(‘statStruct’).style.color = r.structure===‘bullish’?‘var(–bull)’:r.structure===‘bearish’?‘var(–bear)’:‘var(–warn)’;
document.getElementById(‘statATR’).textContent = r.fmt(r.atr);
document.getElementById(‘statBody’).textContent = r.bodyPct + ‘%’;

if (!r.sigs.length) r.sigs.push({t:‘warn’, txt:‘No strong pattern detected. Wait for a clearer setup.’});
document.getElementById(‘sigList’).innerHTML = r.sigs.map(s => {
const ic = s.t===‘bull’?‘▲’:s.t===‘bear’?‘▼’:‘◆’;
const c  = s.t===‘bull’?‘var(–bull)’:s.t===‘bear’?‘var(–bear)’:‘var(–warn)’;
return `<div class="sig-item"><div class="sig-icon" style="color:${c}">${ic}</div><div class="sig-text">${s.txt}</div></div>`;
}).join(’’);

const lv = r.levels;
document.getElementById(‘levList’).innerHTML = ` <div class="lev-row"><span class="lev-name">Supply / High</span><span class="lev-val" style="color:var(--bear)">${r.fmt(lv.hi)}</span><span class="lev-tag tag-supply">SUPPLY</span></div> <div class="lev-row"><span class="lev-name">Mid Level</span><span class="lev-val" style="color:var(--warn)">${r.fmt(lv.mid)}</span><span class="lev-tag tag-mid">50%</span></div> <div class="lev-row"><span class="lev-name">Demand / Low</span><span class="lev-val" style="color:var(--bull)">${r.fmt(lv.lo)}</span><span class="lev-tag tag-demand">DEMAND</span></div> <div class="lev-row"><span class="lev-name">Current Price</span><span class="lev-val" style="color:var(--bright)">${r.fmt(lv.cur)}</span><span class="lev-tag tag-cur">LIVE</span></div>`;

const sc = r.scalp, isL = r.bias === ‘LONG’;
document.getElementById(‘scalpTitle’).textContent = mode===‘scalp’ ? ‘Scalp Setup — Short Burst’ : ‘Trade Setup — Balanced’;
document.getElementById(‘scalpGrid’).innerHTML = ` <div class="scalp-item"><div class="scalp-item-lbl">Entry</div><div class="scalp-item-val" style="color:${col}">${r.fmt(sc.entry)}</div></div> <div class="scalp-item"><div class="scalp-item-lbl">Stop Loss</div><div class="scalp-item-val" style="color:var(--bear)">${r.fmt(isL?sc.slL:sc.slS)}</div></div> <div class="scalp-item"><div class="scalp-item-lbl">TP1</div><div class="scalp-item-val" style="color:var(--bull)">${r.fmt(isL?sc.tp1L:sc.tp1S)}</div></div> <div class="scalp-item"><div class="scalp-item-lbl">TP2</div><div class="scalp-item-val" style="color:var(--bull)">${r.fmt(isL?sc.tp2L:sc.tp2S)}</div></div> <div class="scalp-item"><div class="scalp-item-lbl">R:R Ratio</div><div class="scalp-item-val" style="color:${r.rrGood?'var(--bull)':'var(--bear)'}">${r.rrStr}:1</div></div> <div class="scalp-item"><div class="scalp-item-lbl">ATR (avg)</div><div class="scalp-item-val" style="color:var(--text)">${r.fmt(r.atr)}</div></div>`;

drawChart(cc, r);
document.getElementById(‘results’).scrollIntoView({behavior:‘smooth’, block:‘nearest’});
}

function drawChart(cc, r) {
const cv = document.getElementById(‘cv’), dpr = window.devicePixelRatio || 1;
const W = cv.offsetWidth || 340, H = 140;
cv.width = W*dpr; cv.height = H*dpr; cv.style.width = W+‘px’; cv.style.height = H+‘px’;
const ctx = cv.getContext(‘2d’); ctx.scale(dpr, dpr);
const pad = {t:10,b:10,l:6,r:52}, cw = W-pad.l-pad.r, ch = H-pad.t-pad.b;
const hi = r.levels.hi, lo = r.levels.lo, span = hi-lo||1;
const toY = p => pad.t + ch - ((p-lo)/span)*ch;
const n = cc.length, slotW = cw/n, barW = Math.min(slotW*0.5, 14);

ctx.fillStyle=‘rgba(240,48,96,0.07)’;
ctx.fillRect(pad.l, toY(hi), cw, Math.max(2, toY(hi-span*0.06)-toY(hi)));
ctx.fillStyle=‘rgba(5,240,160,0.07)’;
ctx.fillRect(pad.l, toY(lo+span*0.06), cw, Math.max(2, toY(lo)-toY(lo+span*0.06)));
ctx.strokeStyle=‘rgba(240,192,48,0.2)’; ctx.setLineDash([3,5]); ctx.lineWidth=1;
ctx.beginPath(); ctx.moveTo(pad.l,toY(r.levels.mid)); ctx.lineTo(pad.l+cw,toY(r.levels.mid)); ctx.stroke();
ctx.setLineDash([]);

ctx.font=‘8px IBM Plex Mono’; ctx.textAlign=‘left’;
ctx.fillStyle=‘rgba(240,48,96,0.7)’;  ctx.fillText(r.fmt(hi),       pad.l+cw+4, toY(hi)+4);
ctx.fillStyle=‘rgba(240,192,48,0.6)’; ctx.fillText(r.fmt(r.levels.mid), pad.l+cw+4, toY(r.levels.mid)+4);
ctx.fillStyle=‘rgba(5,240,160,0.7)’;  ctx.fillText(r.fmt(lo),       pad.l+cw+4, toY(lo)+4);

cc.forEach((c, i) => {
const x = pad.l + i*slotW + slotW/2, bull = c.c >= c.o;
const alpha = mode===‘balanced’ && i < 5 ? 0.45 : 0.9;
const col = bull ? ‘#05f0a0’ : ‘#f03060’;
ctx.strokeStyle=col; ctx.lineWidth=1; ctx.globalAlpha=alpha;
ctx.beginPath(); ctx.moveTo(x,toY(c.h)); ctx.lineTo(x,toY(c.l)); ctx.stroke();
const bTop=toY(Math.max(c.o,c.c)), bBot=toY(Math.min(c.o,c.c));
ctx.fillStyle=col; ctx.fillRect(x-barW/2, bTop, barW, Math.max(1.5, bBot-bTop));
});
ctx.globalAlpha=1;
ctx.fillStyle=‘rgba(200,224,240,0.8)’; ctx.font=‘9px IBM Plex Mono’; ctx.textAlign=‘right’;
ctx.fillText(r.fmt(cc[n-1].c), W-2, toY(cc[n-1].c)-3);
}

// Init
buildTFRow();
</script>

