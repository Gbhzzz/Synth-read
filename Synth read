<script>
// ─── STATE ────────────────────────────────────────────
let inst = 'R_75', instFull = 'VIX 75';
let tf = 'M5', mode = 'scalp', isStep = false;

const TF_SCALP    = [‘M1’,‘M5’,‘M15’];
const TF_BALANCED = [‘M5’,‘M15’,‘M30’,‘H1’,‘H4’];
const GRAN = { M1:60, M5:300, M15:900, M30:1800, H1:3600, H4:14400 };

// Deriv public app_id — no auth needed for price history
const APP_ID = 1089;

function buildTFRow() {
const tfs = mode === ‘scalp’ ? TF_SCALP : TF_BALANCED;
if (!tfs.includes(tf)) tf = tfs[0];
document.getElementById(‘tfRow’).innerHTML = tfs.map(t =>
`<div class="tf-btn${t===tf?' active':''}" onclick="setTF(this,'${t}')">${t}</div>`).join(’’);
}

function setMode(m) {
mode = m;
const bS = document.getElementById(‘btnScalp’), bB = document.getElementById(‘btnBalanced’);
const banner = document.getElementById(‘modeBanner’), fb = document.getElementById(‘fetchBtn’);
if (m === ‘scalp’) {
bS.className = ‘mode-btn active-scalp’; bB.className = ‘mode-btn’;
banner.className = ‘mode-banner scalp-banner’;
banner.innerHTML = ‘⚡ <b>Scalp Mode — 5 candles.</b> Best for M1–M5. Quick burst reads and tight signals.’;
fb.className = ‘fetch-btn’; tf = ‘M5’;
} else {
bB.className = ‘mode-btn active-balanced’; bS.className = ‘mode-btn’;
banner.className = ‘mode-banner balanced-banner’;
banner.innerHTML = ‘⚖️ <b>Balanced Mode — 10 candles.</b> Best for M15–H1. Deeper structure and trend reads.’;
fb.className = ‘fetch-btn balanced-fetch’; tf = ‘M15’;
}
buildTFRow();
document.getElementById(‘results’).style.display = ‘none’;
document.getElementById(‘candlePreview’).style.display = ‘none’;
document.getElementById(‘errorBox’).style.display = ‘none’;
}

function setInst(el, code, full) {
document.querySelectorAll(’.pill’).forEach(p => p.classList.remove(‘active’,‘step-active’));
isStep = (code === ‘stpRNG’);
el.classList.add(isStep ? ‘step-active’ : ‘active’);
inst = code; instFull = full;
}

function setTF(el, t) {
document.querySelectorAll(’.tf-btn’).forEach(b => b.classList.remove(‘active’));
el.classList.add(‘active’); tf = t;
}

function showLoading(msg) {
document.getElementById(‘loadingWrap’).classList.add(‘show’);
document.getElementById(‘loadingText’).textContent = msg;
document.getElementById(‘errorBox’).style.display = ‘none’;
document.getElementById(‘fetchBtn’).disabled = true;
}

function hideLoading() {
document.getElementById(‘loadingWrap’).classList.remove(‘show’);
document.getElementById(‘fetchBtn’).disabled = false;
}

function showError(msg) {
hideLoading();
const eb = document.getElementById(‘errorBox’);
eb.innerHTML = msg;
eb.style.display = ‘block’;
}

// ─── FETCH FROM DERIV ─────────────────────────────────
function fetchAndAnalyze() {
const need  = mode === ‘scalp’ ? 5 : 10;
const gran  = GRAN[tf];
// Request extra candles to ensure we have enough closed ones
const count = need + 3;

showLoading(‘Fetching live candles…’);
document.getElementById(‘results’).style.display = ‘none’;
document.getElementById(‘candlePreview’).style.display = ‘none’;

const wsUrl = `wss://ws.binaryws.com/websockets/v3?app_id=${APP_ID}`;
let ws;

try {
ws = new WebSocket(wsUrl);
} catch(e) {
showError(‘WebSocket not supported. Please open this tool from the published URL in Safari.’);
return;
}

const timeout = setTimeout(() => {
try { ws.close(); } catch(e){}
showError(‘Connection timed out. Check your internet connection and try again.’);
}, 12000);

ws.onopen = function() {
document.getElementById(‘loadingText’).textContent = ‘Fetching candles…’;
ws.send(JSON.stringify({
ticks_history: inst,
style: ‘candles’,
granularity: gran,
count: count,
end: ‘latest’,
adjust_start_time: 1
}));
};

ws.onmessage = function(e) {
clearTimeout(timeout);
let data;
try { data = JSON.parse(e.data); } catch(ex) {
showError(‘Invalid response from server. Try again.’); ws.close(); return;
}

